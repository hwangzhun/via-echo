{
  "productName": "VIA Echo",
  "version": "0.1.0",
  "identifier": "com.viaecho.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VIA Echo",
        "width": 560,
        "height": 400,
        "minWidth": 500,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "DOIO KB16 四层键位实时悬浮提示器",
    "shortDescription": "DOIO KB16 键位提示器",
    "resources": ["resources/*"]
  },
  "plugins": {}
}
