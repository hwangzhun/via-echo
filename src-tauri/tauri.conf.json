{
  "productName": "viaecho",
  "version": "0.3.0",
  "identifier": "com.viaecho.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "viaecho",
        "width": 560,
        "height": 420,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "index.html?window=settings",
        "title": "viaecho · 配置",
        "width": 960,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "DOIO KB16 四层键位实时悬浮提示器",
    "shortDescription": "DOIO KB16 键位提示器",
    "resources": [
      "resources/*"
    ]
  },
  "plugins": {}
}
